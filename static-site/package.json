{
  "name": "voidbase-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "jstypes": "typedoc --options ./jsvm/typedoc.json",
    "dev": "vite dev",
    "build": "vite build && rm -rf static/pagefind && pagefind --site ../pb_public --output-path static/pagefind --glob \"docs/**/*.html\" && rm -rf ../pb_public/pagefind && cp -r static/pagefind ../pb_public/pagefind",
    "preview": "cd .. && bun main.ts --http 127.0.0.1:8090"
  },
  "prettier": {
    "tabWidth": 4,
    "printWidth": 110,
    "svelteBracketNewLine": true
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7",
    "luxon": "^3.5.0",
    "pagefind": "^1.1.1",
    "prismjs": "^1.29.0",
    "sass": "^1.70",
    "svelte": "^5",
    "typedoc": "^0.24.8",
    "typedoc-theme-hierarchy": "^4.0.0",
    "vite": "^8"
  },
  "dependencies": {
    "pocketbase": "^0.28.0"
  }
}
