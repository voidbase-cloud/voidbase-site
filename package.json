{
  "dependencies": {
    "@void/react": "^0.10.13",
    "@voidbase-cloud/sdk": "0.5.0",
    "@voidbase-cloud/voidbase": "0.9.0-beta.47",
    "marked": "^18.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "thesvg": "^3.3.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "sass": "^1.104.0",
    "vite": "^8.2.2",
    "void": "^0.10.13"
  },
  "name": "voidbase-site-refactor",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "preview": "bun .voidbase/main.ts --http 127.0.0.1:8090",
    "serve": "bun .voidbase/main.ts --http 0.0.0.0:8090",
    "check": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.server.json",
    "deploy": "bunx voidbase sync --name voidbase-site --domain voidbase.cloud,www.voidbase.cloud",
    "test": "bun test/cursor-playback.ts && bun test/cloud.ts",
    "live": "bun test/cloud-live.ts",
    "provision": "bun test/cloud-provision.ts"
  },
  "type": "module"
}
