{
  "dependencies": {
    "@void/react": "^0.10.13",
    "@voidbase-cloud/voidbase": "0.9.0-beta.12",
    "marked": "^18.0.12",
    "pocketbase": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "thesvg": "^3.3.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "sass": "^1.104.0",
    "vite": "^8.2.2",
    "void": "^0.10.13"
  },
  "name": "voidbase-site-refactor",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bun scripts/pipeline.ts build",
    "preview": "bun .voidbase/main.ts --http 127.0.0.1:8090",
    "serve": "bun .voidbase/main.ts --http 0.0.0.0:8090",
    "check": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.server.json",
    "deploy": "bun scripts/pipeline.ts deploy",
    "test": "bun test/cursor-playback.ts && bun test/cloud.ts",
    "version": "bun scripts/pipeline.ts version",
    "build:site": "bunx --bun vite build"
