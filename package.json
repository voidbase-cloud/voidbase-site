{
  "name": "vb",
  "private": true,
  "type": "module",
  "description": "The voidbase site's own backend: PocketBase's API and admin panel plus the voidbase cloud control plane (Cloudflare sign-in, one-click instances), as a Bun process locally and on Cloudflare Workers in production",
  "scripts": {
    "dev": "voidbase serve --dev --entry main.ts --http 0.0.0.0:8090",
    "dev:custom": "voidbase serve --dev --entry main.ts --http 0.0.0.0:8090 --publicDir ../sk/build",
    "start": "bun main.ts --http 0.0.0.0:8090",
    "start:custom": "bun main.ts --http 0.0.0.0:8090 --publicDir ../sk/build",
    "check": "tsc -p tsconfig.json",
    "superuser": "voidbase superuser upsert",
    "token": "voidbase token",
    "deploy": "voidbase deploy",
    "bundle": "voidbase bundle",
    "release:push": "voidbase release push",
    "test": "bun test/cloud.ts"
  },
  "dependencies": {
    "@voidbase-cloud/voidbase": "link:@voidbase-cloud/voidbase"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
