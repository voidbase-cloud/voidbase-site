{
  "dependencies": {
    "@void/react": "^0.10.13",
    "@voidbase-cloud/voidbase": "link:@voidbase-cloud/voidbase",
    "pocketbase": "^0.28.1",
    "prismjs": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "sass": "^1.104.0",
    "vite": "^8.2.2",
    "void": "^0.10.13"
  },
  "name": "voidbase-site-refactor",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "preview": "bun .voidbase/main.ts --http 127.0.0.1:8090",
    "serve": "bun .voidbase/main.ts --http 0.0.0.0:8090",
    "check": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.server.json",
    "deploy": "bun run build && cd .voidbase && voidbase deploy",
    "test": "bun test/cloud.ts"
  },
  "type": "module"
}
