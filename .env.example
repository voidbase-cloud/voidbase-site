# Copy this file to .env and EDIT it

# Public site values (URLs, release downloads); the Pages workflow copies this file to .env when .env is absent
PB_REPO_URL            = "https://github.com/voidbase-cloud/voidbase"
PB_JS_SDK_URL          = "https://github.com/pocketbase/js-sdk"
PB_DART_SDK_URL        = "https://github.com/pocketbase/dart-sdk"
PB_BENCHMARKS_URL      = "https://github.com/pocketbase/benchmarks"
PB_DISCUSSIONS_URL     = "https://github.com/voidbase-cloud/voidbase/discussions"
PB_GITHUB_RELEASES_URL = "https://github.com/pocketbase/pocketbase/releases"
PB_GODOC_URL           = "https://pkg.go.dev/github.com/pocketbase/pocketbase"

# release urls
PB_LINUX_AMD_URL  = "https://github.com/pocketbase/pocketbase/releases/download/v0.40.2/pocketbase_0.40.2_linux_amd64.zip"
PB_LINUX_AMD_SIZE = 12
# ---
PB_LINUX_ARM_URL  = "https://github.com/pocketbase/pocketbase/releases/download/v0.40.2/pocketbase_0.40.2_linux_arm64.zip"
PB_LINUX_ARM_SIZE = 11
# ---
PB_WINDOWS_AMD_URL  = "https://github.com/pocketbase/pocketbase/releases/download/v0.40.2/pocketbase_0.40.2_windows_amd64.zip"
PB_WINDOWS_AMD_SIZE = 12
# ---
PB_WINDOWS_ARM_URL  = "https://github.com/pocketbase/pocketbase/releases/download/v0.40.2/pocketbase_0.40.2_windows_arm64.zip"
PB_WINDOWS_ARM_SIZE = 11
# ---
PB_MAC_AMD_URL  = "https://github.com/pocketbase/pocketbase/releases/download/v0.40.2/pocketbase_0.40.2_darwin_amd64.zip"
PB_MAC_AMD_SIZE = 12
# ---
PB_MAC_ARM_URL  = "https://github.com/pocketbase/pocketbase/releases/download/v0.40.2/pocketbase_0.40.2_darwin_arm64.zip"
PB_MAC_ARM_SIZE = 11
PB_VERSION=0.39.11
# the voidbase release shown in the header badge (the PocketBase API version above stays: it is what voidbase speaks)
PB_VB_VERSION=0.1.0

UID=1000
GID=1000
COMPOSE_PROJECT_NAME=vbsk
# needed only if you're exposing through traefik
HTTP_HOSTNAME=vbsk.example.com
# uncomment to enable auditlog
AUDITLOG=posts,users

# Test superuser credentials (upserted when the backend starts; voidbase reads this file from vb/ too)
# Generate a random password:
#   openssl rand -base64 16
#   openssl rand -hex 16
#   pwgen -1 16
# PB_SUPERUSER_EMAIL=admin@example.com
# PB_SUPERUSER_PASSWORD=changeme123

# Test user credentials (created when the backend starts)
# PB_USER_EMAIL=user@example.com
# PB_USER_PASSWORD=changeme123

# Going live on Cloudflare: `cd vb && bun run token` prints the dashboard link that creates this token
# VOIDBASE_DEPLOY_CF_API_KEY=

# the site's voidbase backend (vb/), used by /cloud; the Pages workflow sets it from the PB_VB_URL repository variable
PB_VB_URL=https://api.voidbase.cloud
