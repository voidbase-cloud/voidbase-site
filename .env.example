# Copy this file to .env and EDIT it
UID=1000
GID=1000
COMPOSE_PROJECT_NAME=vbsk
# needed only if you're exposing through traefik
HTTP_HOSTNAME=vbsk.example.com
# uncomment to enable auditlog
AUDITLOG=posts,users

# Test superuser credentials (upserted when the backend starts; voidbase reads this file from vb/ too)
# Generate a random password:
#   openssl rand -base64 16
#   openssl rand -hex 16
#   pwgen -1 16
# PB_SUPERUSER_EMAIL=admin@example.com
# PB_SUPERUSER_PASSWORD=changeme123

# Test user credentials (created when the backend starts)
# PB_USER_EMAIL=user@example.com
# PB_USER_PASSWORD=changeme123

# Going live on Cloudflare: `cd vb && bun run token` prints the dashboard link that creates this token
# VOIDBASE_DEPLOY_CF_API_KEY=
