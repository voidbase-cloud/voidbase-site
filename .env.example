# voidbase site backend (vb): copy to .env for local dev. In production `voidbase deploy` bakes the vars listed in
# VOIDBASE_DEPLOY_VARS and stores VOIDBASE_DEPLOY_SECRETS as Worker secrets; VOIDBASE_WORKER_NAME/ACCOUNT_ID are baked automatically.
VOIDBASE_SUPERUSER_EMAIL=admin@example.com
VOIDBASE_SUPERUSER_PASSWORD=changeme123
# seals the settings row and the Cloudflare tokens in cf_connections (32 chars: openssl rand -hex 16); required once deployed
VOIDBASE_ENCRYPTION_KEY=

# Cloudflare OAuth client (dash.cloudflare.com > Manage Account > OAuth clients > Create client):
#   grant type authorization_code, response type code, token auth client_secret_post, redirect URL
#   <this backend>/api/oauth2-redirect (e.g. http://127.0.0.1:8090/api/oauth2-redirect and the workers.dev URL).
#   A private client works for members of your own account; a public one (the site's) needs the client URL verified by DNS TXT and a logo.
CF_OAUTH_CLIENT_ID=
CF_OAUTH_CLIENT_SECRET=
# scopes requested at login: offline_access (a refresh token), identity + granted accounts (User Details Read, Account Settings Read)
# and what provisioning needs (Workers Scripts, D1, R2 + bucket items, Queues write). Ids as returned by
#   curl -H "Authorization: Bearer <api token>" https://api.cloudflare.com/client/v4/oauth/scopes
CF_OAUTH_SCOPES=offline_access user-details.read account-settings.read workers-scripts.write d1.write workers-r2.write workers-r2-bucket-item.read workers-r2-bucket-item.write queues.write

# GitHub OAuth app for the template marketplace (github.com > Settings > Developer settings > OAuth Apps > New):
#   Authorization callback URL <this backend>/api/vbcloud/github/callback (add http://127.0.0.1:8090/api/vbcloud/github/callback for local dev).
#   Scopes are requested at connect time: repo (create from a template, set Actions variables, private repos), read:user, user:email.
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=
GH_OAUTH_SCOPES=repo read:user user:email
# where GitHub's callback sends the browser back to (the site); defaults to https://voidbase.cloud once deployed, http://127.0.0.1:5173 locally
VB_SITE_URL=
# this site's own repository, listed to admins as a system row wired to this backend (dogfooding); empty disables it
VB_SITE_REPO=voidbase-cloud/voidbase-site

# users (by email) who see the site's own backend instance on the /cloud page; deleting it also needs VB_ALLOW_SELF_DELETE=1
VB_ADMIN_EMAILS=
VB_ALLOW_SELF_DELETE=0
# worker name prefix for created instances and the per-user limit
VB_INSTANCE_PREFIX=vb-
VB_MAX_INSTANCES_PER_USER=5

# the Worker's name (and the prefix of its D1/R2/queue); pinned so a checkout under any directory name deploys to the same Worker
VOIDBASE_DEPLOY_NAME=voidbase-site-backend

# what `voidbase deploy` should carry into the Worker
VOIDBASE_DEPLOY_VARS=CF_OAUTH_SCOPES,VB_ADMIN_EMAILS,VB_INSTANCE_PREFIX,VB_MAX_INSTANCES_PER_USER,VB_ALLOW_SELF_DELETE,GH_OAUTH_SCOPES,VB_SITE_URL,VB_SITE_REPO
VOIDBASE_DEPLOY_SECRETS=CF_OAUTH_CLIENT_ID,CF_OAUTH_CLIENT_SECRET,GH_OAUTH_CLIENT_ID,GH_OAUTH_CLIENT_SECRET,VOIDBASE_ENCRYPTION_KEY
# VOIDBASE_DEPLOY_CF_API_KEY=   # only for `voidbase deploy` from this machine (voidbase token prints the link); account-owned
# VOIDBASE_DEPLOY_ZONE_TOKEN=   # user-owned token with Zone > Single Redirect (edit): writes the per-hostname rules of
#                               # static-site/static/_redirects as zone Redirect Rules (account-owned tokens cannot carry that permission)

# Workers Free allows 5 cron triggers per account; 0 skips the hourly maintenance trigger (maintenance then runs lazily)
VOIDBASE_DEPLOY_CRON=0

# custom domains (a zone on the deploy account; comma separated, the first is the URL); workers.dev is turned off when set.
# The Worker serves the site from pb_public at / and the API at /api, so the apex is the site's own address.
VOIDBASE_DEPLOY_DOMAIN=voidbase.cloud,www.voidbase.cloud,api.voidbase.cloud
# where the site build lives; ./pb_public is picked up automatically when present (PocketBase's convention)
# VOIDBASE_DEPLOY_PUBLIC_DIR=pb_public
